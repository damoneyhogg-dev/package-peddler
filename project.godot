[application]
config/name="Package Peddler"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
look_left={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventJoypadButton,"button_index":9)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":0)]}
camera_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":86),Object(InputEventJoypadButton,"button_index":3)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
choice_one={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49),Object(InputEventJoypadButton,"button_index":2)]}
choice_two={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50),Object(InputEventJoypadButton,"button_index":3)]}
choice_three={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51),Object(InputEventJoypadButton,"button_index":0)]}
choice_four={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52),Object(InputEventJoypadButton,"button_index":1)]}
menu_cancel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
combat_light={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"button_index":2)]}
combat_heavy={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":3)]}
combat_block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76),Object(InputEventJoypadButton,"button_index":9)]}
combat_dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":1)]}
combat_retreat={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":10)]}

[physics]
3d/default_gravity=18.0
